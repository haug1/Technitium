{
  "$schema": "../technitium.schema.json",
  "schemaVersion": 1,
  "dns": {
    "tsigKeys": {
      "transfer.example.test": {
        "algorithm": "hmac-sha256",
        "secret": {"file": "/run/secrets/technitium-transfer-key"}
      }
    }
  },
  "web": {
    "tlsEnabled": true,
    "certificate": {
      "path": "certs/web.pfx",
      "password": {"environment": "TECHNITIUM_WEB_CERT_PASSWORD"}
    }
  },
  "auth": {
    "ldap": {
      "enabled": true,
      "server": "directory.example.test",
      "sslOption": "StartTLS",
      "bindUsername": "cn=dns,dc=example,dc=test",
      "bindPassword": {"file": "/run/secrets/technitium-ldap-password"},
      "searchBase": "dc=example,dc=test"
    }
  }
}
